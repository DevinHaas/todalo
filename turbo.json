{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PORT", "RAMBLE_PORT", "RAMBLE_HOST", "RAMBLE_ALLOWED_ORIGINS", "RAMBLE_LLM_PROVIDER", "RAMBLE_LLM_MODEL", "RAMBLE_LLM_BASE_URL", "RAMBLE_STT_PROVIDER", "RAMBLE_STT_URL", "NEXT_PUBLIC_RAMBLE_WS_URL"],
  "globalPassThroughEnv": ["DATABASE_URL", "BETTER_AUTH_SECRET", "BETTER_AUTH_URL", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "ELEVENLABS_API_KEY", "FISH_API_KEY", "GEMINI_API_KEY", "GROQ_API_KEY", "RAMBLE_LLM_API_KEY"],
  "tasks": {
    "dev": { "cache": false, "persistent": true },
    "build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**", "dist/**"] },
    "typecheck": { "dependsOn": ["^typecheck"], "outputs": [] },
    "lint": { "outputs": [] },
    "test": { "outputs": [] }
  }
}
