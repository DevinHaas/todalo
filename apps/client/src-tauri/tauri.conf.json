{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "todalo",
  "version": "0.1.0",
  "identifier": "app.todalo.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "todalo",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:*; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "iOS": { "minimumSystemVersion": "15.4" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["app.todalo.client"], "appLink": false }],
      "desktop": { "schemes": ["app.todalo.client"] }
    }
  }
}
