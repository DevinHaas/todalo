# Neon Postgres connection string (Phase 1)
DATABASE_URL=

# Better Auth (Phase 2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Ramble API server only. Never use a NEXT_PUBLIC_ name for this key.
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
RAMBLE_LLM_PROVIDER=gemini
RAMBLE_LLM_MODEL=gemini-3.5-flash-lite
# Lowest latency: OpenRouter via Cerebras, Groq fallback (defaults to openai/gpt-oss-120b).
# RAMBLE_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
RAMBLE_STT_PROVIDER=elevenlabs
# Seconds of silence before ElevenLabs commits a phrase (default 0.6).
# RAMBLE_VAD_SILENCE_SECS=0.6
# Clip-based alternative without partial transcripts:
# RAMBLE_STT_PROVIDER=fish
FISH_API_KEY=
# Local transcription: whisper-server --host 127.0.0.1 --port 8080 -m models/ggml-base.bin -l auto
# RAMBLE_STT_PROVIDER=local
# RAMBLE_STT_URL=http://127.0.0.1:8080/inference
# Optional override for hosted or local OpenAI-compatible serving.
# RAMBLE_LLM_PROVIDER=compatible
# RAMBLE_LLM_BASE_URL=http://localhost:11434/v1
# RAMBLE_LLM_MODEL=qwen3.5:4b
# RAMBLE_LLM_API_KEY=
# For an entirely local pipeline, run bun run --filter @todalo/api local-models,
# then use RAMBLE_STT_PROVIDER=local and these task-model settings:
# RAMBLE_LLM_PROVIDER=ollama
# RAMBLE_LLM_MODEL=qwen3.5:4b
# Leave RAMBLE_LLM_BASE_URL unset for native Ollama on 127.0.0.1:11434.
RAMBLE_PORT=3001
# Defaults to the origin of BETTER_AUTH_URL; comma-separated when needed.
RAMBLE_ALLOWED_ORIGINS=http://localhost:3000

# Coach (goals ticket 17): encrypts users' AI provider API keys at rest, and
# ChatGPT sign-in tokens (ticket 18, which needs no other setting).
# Generate with: openssl rand -base64 32
COACH_SECRET_KEY=

# Todoist import (register at https://app.todoist.com/app/settings/integrations/app-management;
# redirect URL <BETTER_AUTH_URL>/api/v1/imports/todoist/callback)
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=

# Landing page founder counter (optional): the 50%-off coupon limited to 20 redemptions.
# STRIPE_SECRET_KEY=
# STRIPE_FOUNDERS_COUPON=

# FeatureSpace (integration request form). Unset in production (defaults to https://featurespace.dev).
# Local: point at the FeatureSpace dev server.
# NEXT_PUBLIC_FEATURESPACE_HOST=http://featurespace.localhost:3000

# Monitoring. Each tool stays off while its key is unset (local development).
# Sentry (EU, de.sentry.io): errors, traces and logs. One project per app.
# SENTRY_DSN=                      # API (apps/api)
# NEXT_PUBLIC_SENTRY_DSN=          # landing site (apps/web), build time
# VITE_SENTRY_DSN=                 # app (apps/client), build time
# SENTRY_ORG= SENTRY_PROJECT= SENTRY_AUTH_TOKEN=   # web build: uploads source maps
# PostHog (EU, eu.posthog.com): product analytics. One project for the site and the app.
# NEXT_PUBLIC_POSTHOG_KEY=         # landing site, cookieless
# VITE_POSTHOG_KEY=                # app, identified by account

# File storage (Cloudflare R2, EU bucket "todalo-files"). Unset: attachment bytes stay in the database as base64.
# R2_ENDPOINT=https://<account-id>.eu.r2.cloudflarestorage.com
# R2_BUCKET=todalo-files
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
